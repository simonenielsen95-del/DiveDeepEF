@{
    @using DiveDeepEF.Models       
}

<title>BCD'er'</title>
<main style="text-align: center;">
<div class="row">
@foreach (var bcd in Model)
{
    <div class="card" style="width: 18rem; margin: 10px;">
        <img src="/Image/deep-dive.png" class="card-img-top" alt="...">
        <div class="card-body">
            <h5 class="card-title">@bcd.Model</h5>
            <h6 class="card-subtitle mb-2 text-body-secondary">@bcd.Brand</h6>
                    <p class="card-text">@bcd.AttributeId </p>
            <h6 class="card-text">@bcd.PricePerDay Dkk om dagen</h6>
                    <a asp-area="" asp-controller="Booking" asp-action="Index" asp-route-type="BCD" asp-route-id="@bcd.Id" class="btn btn-primary">Læs mere</a>
        </div>
    </div>
}
</div>
</main>