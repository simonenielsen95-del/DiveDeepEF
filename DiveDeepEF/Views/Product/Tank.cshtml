<title>Ilttanke</title>

<div class="row">
    @foreach (var tank in Model)
    {
        <div class="card" style="width: 18rem;">
            <img src="..." class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">@tank.Brand</h5>
                <h6 class="card-subtitle mb-2 text-body-secondary">@tank.Volume</h6>
                <h6 class="card-text">@tank.PricePerDay Dkk om dagen</h6>
                <a href="#" class="btn btn-primary">Læs mere</a>
            </div>
        </div>
    }
</div>